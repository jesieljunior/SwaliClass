# ==========================================
# SwaliClass Environment Variables Template
# No live credentials or production secrets.
# ==========================================

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000

# Backend .NET 9 & Database Configuration
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=swaliclass_db;Username=postgres;Password=your_password_here
Jwt__Secret=your_minimum_32_character_strong_secret_key_here!
Jwt__Issuer=SwaliClass.WebApi
Jwt__Audience=SwaliClass.Clients

# Docker Compose Defaults
POSTGRES_DB=swaliclass_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres