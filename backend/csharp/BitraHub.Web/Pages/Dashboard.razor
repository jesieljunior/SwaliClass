@page "/"
@page "/dashboard"
@using BitraHub.Application.DTOs
@using BitraHub.Domain.Common

<div class="p-6 max-w-7xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-slate-900">Visão Geral Acadêmica</h1>
            <p class="text-slate-500">Métricas consolidadas de frequência, turmas e avaliações.</p>
        </div>
        <div class="flex gap-3">
            <a href="/chamada" class="px-4 py-2 bg-blue-900 text-white rounded-md font-medium hover:bg-blue-800 transition">
                Fazer Chamada
            </a>
            <a href="/atividades" class="px-4 py-2 bg-slate-100 text-slate-700 rounded-md font-medium hover:bg-slate-200 transition">
                Nova Atividade
            </a>
        </div>
    </div>

    @if (Loading)
    {
        <div class="p-12 text-center text-slate-400">Carregando métricas acadêmicas...</div>
    }
    else
    {
        <!-- KPI Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="p-5 bg-white rounded-xl border border-slate-200 shadow-sm">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total de Alunos</span>
                <div class="text-2xl font-bold text-slate-900 mt-2">@Stats?.TotalStudents</div>
                <span class="text-xs text-emerald-600 mt-1 inline-block">Matrículas ativas</span>
            </div>
            <div class="p-5 bg-white rounded-xl border border-slate-200 shadow-sm">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Turmas Ativas</span>
                <div class="text-2xl font-bold text-slate-900 mt-2">@Stats?.TotalClasses</div>
                <span class="text-xs text-slate-500 mt-1 inline-block">Distribuídas em @Stats?.TotalCourses cursos</span>
            </div>
            <div class="p-5 bg-white rounded-xl border border-slate-200 shadow-sm">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Frequência Média (30d)</span>
                <div class="text-2xl font-bold text-blue-900 mt-2">@Stats?.AttendanceAverage30d%</div>
                <span class="text-xs text-emerald-600 mt-1 inline-block">Dentro da meta institucional</span>
            </div>
            <div class="p-5 bg-white rounded-xl border border-slate-200 shadow-sm">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Correções Pendentes</span>
                <div class="text-2xl font-bold text-amber-600 mt-2">@Stats?.PendingGradingCount</div>
                <span class="text-xs text-slate-500 mt-1 inline-block">Entregas aguardando nota</span>
            </div>
        </div>

        <!-- Recent Activities Table -->
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-200 flex justify-between items-center">
                <h2 class="font-semibold text-slate-800">Próximos Prazos de Atividades</h2>
                <a href="/atividades" class="text-sm text-blue-700 hover:underline">Ver todas</a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 border-b border-slate-200 text-slate-600 uppercase text-xs">
                        <tr>
                            <th class="px-5 py-3">Atividade</th>
                            <th class="px-5 py-3">Turma</th>
                            <th class="px-5 py-3">Prazo</th>
                            <th class="px-5 py-3">Nota Máx.</th>
                            <th class="px-5 py-3 text-right">Entregas</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var activity in Stats?.RecentActivities ?? new())
                        {
                            <tr class="hover:bg-slate-50 transition">
                                <td class="px-5 py-3 font-medium text-slate-900">@activity.Title</td>
                                <td class="px-5 py-3 text-slate-600">@activity.ClassName</td>
                                <td class="px-5 py-3 text-slate-600">@activity.DueDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="px-5 py-3 font-mono text-slate-800">@activity.MaxScore.ToString("F1")</td>
                                <td class="px-5 py-3 text-right">
                                    <span class="px-2 py-1 bg-blue-50 text-blue-700 rounded text-xs font-semibold">
                                        @activity.GradedCount / @activity.SubmissionCount
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private DashboardStatsDto? Stats { get; set; }
    private bool Loading { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        // Simulated loading from BitraHub REST API
        await Task.Delay(50);
        Stats = new DashboardStatsDto(
            TotalStudents: 142,
            TotalClasses: 8,
            TotalCourses: 4,
            AttendanceAverage30d: 94.8,
            PendingGradingCount: 6,
            RecentActivities: new List<ActivityDto>
            {
                new(Guid.NewGuid(), Guid.NewGuid(), "3º Ano A - Matutino", "Redação ENEM: Desafios da IA", null, DateTime.UtcNow.AddDays(3), 10.0m, 2.0m, "published", 28, 22, DateTime.UtcNow),
                new(Guid.NewGuid(), Guid.NewGuid(), "2º Ano B - Vespertino", "Lista de Exercícios: Termodinâmica", null, DateTime.UtcNow.AddDays(5), 10.0m, 1.0m, "published", 15, 0, DateTime.UtcNow)
            },
            ClassPerformance: new List<ClassPerformanceDto>()
        );
        Loading = false;
    }
}
