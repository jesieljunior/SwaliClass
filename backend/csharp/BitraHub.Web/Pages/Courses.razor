@page "/cursos"
@using BitraHub.Application.DTOs

<div class="p-6 max-w-7xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-slate-900">Cursos & Grades</h1>
            <p class="text-slate-500">Configuração de programas acadêmicos, carga horária e matriz curricular.</p>
        </div>
        <button class="px-4 py-2 bg-blue-900 text-white rounded-md font-medium hover:bg-blue-800 transition">
            + Novo Curso
        </button>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm flex justify-between items-center">
            <span>⛔ @ErrorMessage</span>
            <button class="text-red-900 font-bold" @onclick='() => ErrorMessage = null'>✕</button>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @foreach (var c in Courses)
        {
            <div class="p-6 bg-white rounded-xl border border-slate-200 shadow-sm">
                <div class="flex justify-between items-start">
                    <div>
                        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">@c.Category</span>
                        <h2 class="text-xl font-bold text-slate-900 mt-1">@c.Name</h2>
                    </div>
                    <span class="text-xs font-mono bg-blue-50 text-blue-800 px-2.5 py-1 rounded-full font-semibold">
                        @c.WorkloadHours h
                    </span>
                </div>
                <p class="mt-3 text-sm text-slate-600 line-clamp-2">@c.Description</p>
                <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600">
                    <div><strong>@c.ClassCount</strong> turmas vinculadas · <strong>@c.StudentCount</strong> alunos matriculados</div>
                    <div class="flex gap-2">
                        <button class="text-blue-700 font-semibold hover:underline">Editar</button>
                        <button class="text-red-600 font-semibold hover:underline" @onclick="() => TryDelete(c)">Excluir</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string? ErrorMessage { get; set; }

    private List<CourseDto> Courses = new()
    {
        new CourseDto(Guid.NewGuid(), "Ensino Médio Integrado", "Formação geral básica e técnica em informática para internet.", "Educação Básica", 1200, 2, 60, DateTime.UtcNow),
        new CourseDto(Guid.NewGuid(), "Extracurricular de Robótica", "Programação de microcontroladores e inteligência artificial prática.", "Extracurricular", 180, 1, 18, DateTime.UtcNow),
        new CourseDto(Guid.NewGuid(), "Preparatório ENEM Intensivo", "Revisão e banco de questões modelo Bitra AI.", "Preparatório", 320, 0, 0, DateTime.UtcNow)
    };

    private void TryDelete(CourseDto course)
    {
        if (course.ClassCount > 0)
        {
            ErrorMessage = $"Não é possível excluir o curso '{course.Name}' porque existem {course.ClassCount} turma(s) vinculada(s). Exclua ou transfira as turmas antes de continuar.";
            return;
        }

        Courses.Remove(course);
        ErrorMessage = null;
    }
}
